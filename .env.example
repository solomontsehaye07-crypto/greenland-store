# Public URL of this site (no trailing slash)
# Public address of the shop (read at request time)
SITE_URL=https://greenland-store.example.workers.dev

# --- Payments (leave empty to hide a method at checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox            # sandbox | live
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=             # Viva payment source code (4 digits)
VIVA_ENV=demo                 # demo | live

# --- Notifications ---
RESEND_API_KEY=
EMAIL_FROM="Greenland Afro Asia Store <orders@yourdomain.de>"
ALERT_EMAIL_TO=               # where low-stock digests go
# Optional: WhatsApp Cloud API (Meta). Without it, refill orders open WhatsApp with a pre-filled message + PDF link.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Protects /api/cron/* (Vercel sends it automatically as Bearer token)
CRON_SECRET=
